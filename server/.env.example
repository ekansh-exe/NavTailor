# Copy to server/.env for local development. NEVER commit the real .env.
# In production (Docker / Render) set these in the host's environment settings instead.

# Required
MONGODB_URI=
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
GOOGLE_CLIENT_ID=
# Where the app is opened from: http://localhost:5173 in dev, https://<app>.onrender.com in production
CLIENT_ORIGIN=http://localhost:5173

# At least one LLM key, or tailoring and import fail
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional
PORT=5000
# Number of proxies in front of the server in production (measure it, see README). Unset locally.
TRUST_PROXY=
